# =============================================================================
# Configuração de ambiente — SGI-YKR (back-end)
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores. O `.env` NÃO é
# versionado (está no .gitignore). Em produção, defina estas variáveis
# diretamente no painel/ambiente da hospedagem — não suba um `.env` real.
#
# Legenda:
#   [OBRIGATÓRIA EM PRODUÇÃO]  precisa ser definida antes de ir ao ar.
#   [OPCIONAL]                 tem padrão seguro; ajuste só se necessário.
# =============================================================================

# --- Banco de dados ---------------------------------------------------------
# [OBRIGATÓRIA EM PRODUÇÃO]
# String de conexão SQLAlchemy. Se omitida, o sistema cai em SQLite local
# (apenas desenvolvimento): sqlite:///./yokai.db
#
# Em produção, use PostgreSQL com o driver psycopg2 (já incluído no
# requirements.txt):
#   postgresql+psycopg2://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO
#
# Atenção: caracteres especiais na senha (@ : / etc.) devem vir URL-encoded.
DATABASE_URL=sqlite:///./yokai.db

# --- Autenticação (JWT) -----------------------------------------------------
# [OBRIGATÓRIA EM PRODUÇÃO]  >>> NÃO use o valor de exemplo em produção! <<<
# Segredo usado para assinar os tokens JWT. Se vazar, qualquer um pode forjar
# tokens válidos. Gere um valor longo e aleatório (>= 32 bytes). Exemplos:
#   Linux/macOS:  openssl rand -hex 32
#   Python:       python -c "import secrets; print(secrets.token_hex(32))"
#   PowerShell:   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio

# [OPCIONAL] Tempo de expiração do token de acesso, em minutos (padrão: 60).
JWT_EXPIRE_MIN=60

# --- CORS -------------------------------------------------------------------
# [OBRIGATÓRIA EM PRODUÇÃO]
# Lista de origens (front-end) autorizadas a chamar a API, separadas por
# vírgula. Use a origem EXATA (esquema + host + porta), sem barra final e sem
# curingas ("*") em produção.
#   Dev (Angular local):
CORS_ORIGINS=http://localhost:4200
#   Produção (exemplo, múltiplas origens):
#   CORS_ORIGINS=https://app.seudominio.com,https://www.seudominio.com

# --- Agendador da trava de inadimplência ------------------------------------
# [OPCIONAL] Horário do job diário que varre a inadimplência (timezone
# America/Sao_Paulo). Padrão: 00:00 (meia-noite).
TRAVA_JOB_HORA=0
TRAVA_JOB_MINUTO=0

# --- Usuários iniciais ------------------------------------------------------
# No MVP, os usuários da diretoria são criados por `python create_admin.py`
# (credenciais fixas no script). >>> Troque as senhas após o primeiro acesso. <<<
